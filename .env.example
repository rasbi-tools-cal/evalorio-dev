# Copy to .env.local and fill in. See README for where each value comes from.
NEXT_PUBLIC_SITE_URL=https://www.evalorio.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose. Supabase dashboard → Project Settings → API keys → secret key
SUPABASE_SECRET_KEY=
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile). Also set the secret in Supabase Auth → Captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Map tiles. Default is OpenStreetMap (fine for development only; use a commercial provider in production).
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
# NEXT_PUBLIC_MAP_TILE_ORIGINS=https://api.maptiler.com
# Outgoing email (any SMTP provider: Resend, Postmark, SES, Brevo...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Evalorio <no-reply@evalorio.com>"
CRON_SECRET=
IP_HASH_SALT=
# Google sign-in (after configuring the provider in Supabase)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Legal identity shown in the privacy policy, terms and legal notice (required before launch)
# Defaults to "Evalorio" when empty
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_LEGAL_FORM=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_COUNTRY=
NEXT_PUBLIC_COMPANY_REGISTRY=
NEXT_PUBLIC_COMPANY_VAT_ID=
NEXT_PUBLIC_SUPPORT_EMAIL=support@evalorio.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@evalorio.com
# Leave empty if no DPO is designated (the privacy email is shown instead)
NEXT_PUBLIC_COMPANY_DPO=
# Supervisory authority of the country of your main establishment, e.g. "Agencia Española de Protección de Datos (AEPD)"
NEXT_PUBLIC_LEAD_AUTHORITY=
# Vercel Web Analytics (cookieless, only after consent). Set to "off" to remove it and the "Analytics" consent category.
# NEXT_PUBLIC_ANALYTICS=off
# Shown in the privacy policy's list of processors
NEXT_PUBLIC_DATA_REGION=
NEXT_PUBLIC_EMAIL_PROVIDER=
NEXT_PUBLIC_EMAIL_REGION=
